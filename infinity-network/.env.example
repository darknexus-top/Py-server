# Flask Security & Server Configuration
FLASK_SECRET_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
SQLITE_DB_PATH=infinity_network.db
SESSION_COOKIE_SECURE=false
SESSION_TTL_MINUTES=60
RATE_LIMIT_PER_MINUTE=60

# Optional Admin Override (leave empty to claim password via /login on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Nagad Authorized API Configuration (Keep secrets server-side only)
NAGAD_MOCK_MODE=true
NAGAD_BASE_URL=https://app.mynagad.com:20002
NAGAD_CHECK_PATH=/api/user/check-user-status-for-log-in
NAGAD_USER_ASP_ID=100012345612345
NAGAD_USER_AGENT=ANDROID/2113
NAGAD_DEVICE_FGP=
NAGAD_ACCEPT_LANGUAGE=bn
NAGAD_APP_CODE=01
NAGAD_HTTP_USER_AGENT=okhttp/5.0.0-alpha.7
NAGAD_API_KEY=
NAGAD_TIMEOUT_SECONDS=8

# Truecaller Authorized API Configuration (Keep secrets server-side only)
TRUECALLER_MOCK_MODE=true
TRUECALLER_API_URL=
TRUECALLER_API_KEY=
TRUECALLER_TIMEOUT_SECONDS=8
