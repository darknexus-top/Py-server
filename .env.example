# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# INFINITY NETWORK Admin & Security Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_TTL_MINUTES=60
RATE_LIMIT_PER_MINUTE=60
SQLITE_DB_PATH=infinity_network.db

# Nagad Authorized API Configuration (Server-Side Only)
NAGAD_MOCK_MODE=true
NAGAD_BASE_URL=https://app.mynagad.com:20002
NAGAD_CHECK_PATH=/api/user/check-user-status-for-log-in
NAGAD_USER_ASP_ID=100012345612345
NAGAD_USER_AGENT=ANDROID/2113
NAGAD_DEVICE_FGP=
NAGAD_ACCEPT_LANGUAGE=bn
NAGAD_APP_CODE=01
NAGAD_HTTP_USER_AGENT=okhttp/5.0.0-alpha.7
NAGAD_API_KEY=
NAGAD_TIMEOUT_SECONDS=8

# Truecaller Authorized API Configuration (Server-Side Only)
TRUECALLER_MOCK_MODE=true
TRUECALLER_API_URL=
TRUECALLER_API_KEY=
TRUECALLER_TIMEOUT_SECONDS=8
